+func (e *experiment) durableRange() int64 {
+	row, err := e.cluster.TestBase().ShardMgr.GetOrCreateShard(e.ctx, &persistence.GetOrCreateShardRequest{ShardID: e.shardID})
+	require.NoError(e.t, err)
+	return row.ShardInfo.RangeId
+}
