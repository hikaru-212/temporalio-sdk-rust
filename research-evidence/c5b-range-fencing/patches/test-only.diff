+func cloneSet[K comparable](m map[K]struct{}) map[K]struct{} {
+	if m == nil {
+		return nil
+	}
+	r := make(map[K]struct{}, len(m))
+	for k := range m {
+		r[k] = struct{}{}
+	}
+	return r
