+		return &persistence.TimeoutError{Msg: "CCPO C5B2 controlled ambiguous persistence result"}
+	case <-e.done:
+		return fmt.Errorf("INCONCLUSIVE: delegate exited before gate: %w", e.delegateErr)
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
