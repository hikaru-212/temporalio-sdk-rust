+    #[derive(Default)]
+    struct C2dLanguageHost {
+        commands: RefCell<Vec<WorkflowCommand>>,
+    }
+    
+    impl WorkflowHost for C2dLanguageHost {
+        fn set_current_details(&self, _details: String) {}
+    
+        fn push_command(&self, command: WorkflowCommand) {
+            self.commands.borrow_mut().push(command);
+        }
+    }
+    
+    struct C2dLanguageDriver {
+        instance: GuestWorkflowInstance<C2dClockWorkflow>,
+        host: Rc<C2dLanguageHost>,
+        observations: Rc<RefCell<Vec<C2dLanguageObservation>>>,
+        workflow_result: Payload,
+        completed: bool,
+    }
+    
+    impl C2dLanguageDriver {
+        fn new(
+            initial_activation: &WorkflowActivation,
+            namespace: &str,
+            task_queue: &str,
+            expected_la_result: Payload,
+            workflow_result: Payload,
+            original_schedule_time: Option<SystemTime>,
+        ) -> Self {
+            let initialize_workflow = initial_activation
+                .jobs
+                .iter()
+                .find_map(|job| match &job.variant {
+                    Some(Variant::InitializeWorkflow(init)) => Some(init.clone()),
+                    _ => None,
+                })
+                .expect("initial activation contains InitializeWorkflow");
+            assert!(initialize_workflow.arguments.is_empty(), "the registered workflow has no input");
+            let host = Rc::new(C2dLanguageHost::default());
+            let observations = Rc::new(RefCell::new(vec![]));
+            let base_ctx = BaseWorkflowContext::from_raw(
+                WorkflowInit {
+                    namespace: namespace.to_owned(),
+                    task_queue: task_queue.to_owned(),
+                    run_id: initial_activation.run_id.clone(),
+                    initialize_workflow,
+                },
+                DataConverter::default(),
+                host.clone(),
+                None,
+                vec![],
+            );
+            let instance = GuestWorkflowInstance::new_with_workflow(
+                C2dClockWorkflow {
+                    observations: observations.clone(),
+                    expected_la_result,
+                    workflow_result: workflow_result.clone(),
+                    original_schedule_time,
+                },
+                base_ctx,
+                Some(()),
+            );
+            Self {
+                instance,
+                host,
+                observations,
+                workflow_result,
+                completed: false,
+            }
+        }
+    
+        fn activate(&mut self, activation: WorkflowActivation) -> Vec<WorkflowCommand> {
+            assert!(!self.completed, "no workflow activation follows completion");
+            assert!(!activation.jobs.is_empty(), "jobless heartbeat stays inside Core");
+            assert!(activation.jobs.iter().all(|job| matches!(
+                &job.variant,
+                Some(Variant::InitializeWorkflow(_) | Variant::ResolveActivity(_)),
+            )), "this adapter only admits the pre-registered two-job workflow contract");
+            assert!(self.host.commands.borrow().is_empty());
+            let activation_result = self.instance.activate(activation, noop_waker_ref()).unwrap();
+            assert!(activation_result.job_results.iter().all(|result| {
+                matches!(result, ActivationJobResult::None)
+            }));
+            let mut settled = false;
+            for _ in 0..8 {
+                let result = self.instance.poll_routine(MAIN_ROUTINE_ID, noop_waker_ref()).unwrap();
+                match result.completion {
+                    Some(RoutineCompletion::Main(MainRoutineCompletion::Blocked)) => {
+                        if !result.made_progress {
+                            settled = true;
+                            break;
+                        }
+                    }
+                    Some(RoutineCompletion::Main(MainRoutineCompletion::Terminal(outcome))) => {
+                        let TerminalOutcome::Completed(payload) = *outcome else {
+                            panic!("workflow returned an unexpected terminal outcome");
+                        };
+                        assert_eq!(payload, self.workflow_result);
+                        // The native SDK host emits this command from the guest's terminal result.
+                        self.host.push_command(
+                            workflow_command::Variant::CompleteWorkflowExecution(
+                                CompleteWorkflowExecution { result: Some(payload) },
+                            ).into(),
+                        );
+                        self.completed = true;
+                        settled = true;
+                        break;
+                    }
+                    unexpected => panic!("unexpected main routine result: {unexpected:?}"),
+                }
+            }
+            assert!(settled, "language adapter did not settle within the bounded poll budget");
+            std::mem::take(&mut *self.host.commands.borrow_mut())
+        }
+    }
+    
+    const T: u64 = 1_800_000_000;
+    const RUN_ID: &str = "00000000-0000-4000-8000-000000000001";
+    
+    fn save(path: &Path, bytes: &[u8]) {
+        fs::OpenOptions::new().create_new(true).write(true).open(path).unwrap()
+            .write_all(bytes).unwrap();
+    }
+    
+    fn manager() -> WorkflowManager {
+        WorkflowManager::new(RunBasics {
+            worker_config: {
+                let mut config = test_worker_cfg().build().unwrap();
+                config.task_queue = "c2_queue".to_owned();
+                config.into()
+            },
+            workflow_id: "c2-workflow-id".to_owned(),
+            workflow_type: "c2_wf".to_owned(),
+            run_id: RUN_ID.to_owned(),
+            history: HistoryUpdate::dummy(),
+            metrics: MetricsContext::no_op(),
+            capabilities: &Capabilities { sdk_metadata: true, ..Default::default() },
+            sdk_name: "c2d-guest-adapter", sdk_version: "pinned",
+        })
+    }
+    
+    fn update(events: &[HistoryEvent], previous: i64, started: i64) -> HistoryUpdate {
+        let (update, remaining) = HistoryUpdate::from_events(events.to_vec(), previous, started, true);
+        assert!(remaining.is_empty());
+        assert_eq!(update.get_events(), events);
+        println!("C2D HANDOFF previous={previous} started={started} finished=true ids={:?}",
+            events.iter().map(|e| e.event_id).collect::<Vec<_>>());
+        update
+    }
+    
+    fn activation(label: &str, manager: &WorkflowManager, act: &WorkflowActivation, out: &Path) {
+        println!("C2D ACT {label} machines_replaying={} cursor={} last_processed={} full={act:?}",
+            manager.machines.replaying, manager.machines.get_last_wft_started_id(),
+            manager.machines.last_processed_event);
+        save(&out.join(format!("{label}.activation.pb")), &act.encode_to_vec());
+    }
+    
+    fn respond(label: &str, manager: &mut WorkflowManager, lang: &mut C2dLanguageDriver,
+        act: WorkflowActivation) -> Vec<WorkflowCommand> {
+        let commands = lang.activate(act);
+        println!("C2D LANG_COMMANDS {label} {commands:?}");
+        manager.push_commands_and_iterate(commands.clone().into_iter()
+            .map(|c| WFCommand::try_from(c).unwrap()).collect()).unwrap();
+        commands
+    }
+    
+    fn completion(manager: &mut WorkflowManager, event: &mut HistoryEvent) -> Vec<Command> {
+        let commands = manager.machines.get_commands().collect::<Vec<_>>();
+        let metadata = manager.machines.get_metadata_for_wft_complete();
+        println!("C2D LIVE_WFT_COMPLETION id={} commands={commands:?} metadata={metadata:?}", event.event_id);
+        let Some(Attributes::WorkflowTaskCompletedEventAttributes(attrs)) = &mut event.attributes else {
+            panic!("expected completed WFT");
+        };
+        attrs.sdk_metadata = Some(metadata);
+        commands
+    }
+    
+    #[test]
+    fn live_replay_semantic_convergence() {
+        let subscriber = tracing_subscriber::fmt().with_max_level(tracing::Level::TRACE)
+            .without_time().with_ansi(false)
+            .with_span_events(tracing_subscriber::fmt::format::FmtSpan::NEW).finish();
+        let _subscriber = tracing::subscriber::set_default(subscriber);
+        assert!(crate::worker::workflow::chunking_v2_enabled());
+        let out = std::path::PathBuf::from(std::env::var("C2D_OUTPUT_DIR").unwrap());
+        let original = History::decode(fs::read(std::env::var("C2D_ORIGINAL_E2").unwrap()).unwrap().as_slice()).unwrap();
+        assert_eq!(original.events.len(), 12);
+        let mut history = original.clone();
+        let Some(Attributes::MarkerRecordedEventAttributes(marker)) = &history.events[10].attributes else {
+            panic!("original E2 marker missing");
+        };
+        let (original_marker, result) = extract_local_activity_marker_details(&mut marker.details.clone());
+        let original_marker = original_marker.unwrap();
+        let result = result.unwrap();
+        let Some(Attributes::WorkflowExecutionCompletedEventAttributes(terminal)) = &history.events[11].attributes else {
+            panic!("original E2 terminal missing");
+        };
+        let workflow_result = terminal.result.as_ref().unwrap().payloads[0].clone();
+        assert_eq!(original_marker.seq, 1);
+        println!("C2D PATH warm");
+        let mut live = manager();
+        let first = live.new_work_from_server(update(&history.events[..3], 0, 3), vec![]).unwrap();
+        activation("warm-init", &live, &first, &out);
+        let mut warm_lang = C2dLanguageDriver::new(&first, "c2-namespace", "c2_queue",
+            result.clone(), workflow_result.clone(), None);
+        let warm_initial_commands = respond("warm-init", &mut live, &mut warm_lang, first);
+        let requests = live.drain_queued_local_activities();
+        let [LocalActRequest::New(request)] = requests.as_slice() else { panic!("expected exactly one LA request"); };
+        assert_eq!(request.schedule_cmd.seq, 1);
+        assert_eq!(request.schedule_cmd.activity_id, "la-1");
+        assert_eq!(request.schedule_cmd.activity_type, "c2_la");
+        assert_eq!(request.schedule_cmd.attempt, 1);
+        let original_schedule_time = request.schedule_cmd.original_schedule_time;
+        println!("C2D LA_DISPATCH warm request={request:?} original_schedule_time={original_schedule_time:?}");
+        let mut warm_execution_count = 0;
+        let mut execute_la = || { warm_execution_count += 1; result.clone() };
+        let held_result = execute_la();
+        assert!(completion(&mut live, &mut history.events[3]).is_empty());
+        live.wft_completion_reported();
+        let at6 = live.new_work_from_server(update(&history.events[3..6], 3, 6), vec![]).unwrap();
+        activation("warm-heartbeat6", &live, &at6, &out);
+        assert!(at6.jobs.is_empty());
+        assert!(!live.machines.replaying);
+        assert_eq!(at6.timestamp.as_ref().unwrap().seconds, (T+8) as i64);
+        assert_eq!(at6.history_length, 6);
+        assert_eq!(live.machines.outstanding_local_activity_count(), 1);
+        assert!(live.drain_queued_local_activities().is_empty());
+        assert!(completion(&mut live, &mut history.events[6]).is_empty());
+        live.wft_completion_reported();
+        let at9 = live.new_work_from_server(update(&history.events[6..9], 6, 9), vec![]).unwrap();
+        activation("warm-heartbeat9", &live, &at9, &out);
+        assert!(at9.jobs.is_empty());
+        assert!(!live.machines.replaying);
+        assert_eq!(at9.timestamp.as_ref().unwrap().seconds, (T+16) as i64);
+        assert_eq!(at9.history_length, 9);
+        assert_eq!(live.machines.outstanding_local_activity_count(), 1);
+        assert!(live.drain_queued_local_activities().is_empty());
+        println!("C2D LA_COMPLETE warm count={warm_execution_count} runtime=17 original={original_schedule_time:?}");
+        live.notify_of_local_result(LocalResolution::LocalActivity(LocalActivityResolution {
+            seq: 1, result: LocalActivityExecutionResult::Completed(Success { result: Some(held_result) }),
+            runtime: Duration::from_secs(17), attempt: 1, backoff: None, original_schedule_time,
+        })).unwrap();
+        let warm_resume = live.get_next_activation().unwrap();
+        activation("warm-resume", &live, &warm_resume, &out);
+        let warm_final_commands = respond("warm-resume", &mut live, &mut warm_lang, warm_resume.clone());
+        let final_commands = completion(&mut live, &mut history.events[9]);
+        let [marker_command, complete_command] = final_commands.as_slice() else { panic!("expected marker and completion"); };
+        let Some(CommandAttributes::RecordMarkerCommandAttributes(command_marker)) = &marker_command.attributes else {
+            panic!("first command must record LA marker");
+        };
+        let Some(CommandAttributes::CompleteWorkflowExecutionCommandAttributes(command_complete)) = &complete_command.attributes else {
+            panic!("second command must complete workflow");
+        };
+        let Some(Attributes::MarkerRecordedEventAttributes(marker)) = &mut history.events[10].attributes else { unreachable!() };
+        assert_eq!(marker.marker_name, command_marker.marker_name);
+        assert_eq!(marker.failure, command_marker.failure);
+        assert_eq!(marker.header, command_marker.header);
+        marker.details = command_marker.details.clone();
+        let (marker_data, marker_result) = extract_local_activity_marker_details(&mut marker.details.clone());
+        let marker_data = marker_data.unwrap();
+        assert_eq!(marker_result, Some(result.clone()));
+        assert_eq!(marker_data.original_schedule_time, original_schedule_time.map(Into::into));
+        let mut expected_marker = original_marker;
+        expected_marker.original_schedule_time = original_schedule_time.map(Into::into);
+        assert_eq!(marker_data, expected_marker);
+        let Some(Attributes::WorkflowExecutionCompletedEventAttributes(terminal)) = &history.events[11].attributes else { unreachable!() };
+        assert_eq!(terminal.result, command_complete.result);
+        assert_eq!(terminal.workflow_task_completed_event_id, 10);
+        let mut version = RunVersion::default();
+        version.observe(&history.events).unwrap();
+        assert_eq!(version.selected(), Some(true));
+        for (index, event) in history.events.iter().enumerate() {
+            assert_eq!(event.event_id, index as i64 + 1);
+            assert_eq!(event.event_time, original.events[index].event_time);
+            if ![3, 6, 9, 10].contains(&index) { assert_eq!(event, &original.events[index]); }
+        }
+        let encoded = history.encode_to_vec();
+        save(&out.join("E2-D.pb"), &encoded);
+        save(&out.join("E2-D.decoded.txt"), format!("{history:#?}\n").as_bytes());
+        save(&out.join("original-E2.decoded.txt"), format!("{original:#?}\n").as_bytes());
+        save(&out.join("warm.commands.txt"), format!("initial={warm_initial_commands:#?}\nfinal={warm_final_commands:#?}\nserver={final_commands:#?}\n").as_bytes());
+        assert!(warm_lang.completed);
+        assert!(live.machines.workflow_is_finished());
+        assert_eq!(live.machines.outstanding_local_activity_count(), 0);
+        assert_eq!(warm_execution_count, 1);
+        println!("C2D WARM_NORMAL_COMPLETION commands accepted; terminal history awaits modeled Server commit");
+    
+        println!("C2D PATH cold");
+        let replay_history = History::decode(encoded.as_slice()).unwrap();
+        assert_eq!(replay_history, history);
+        let mut cold = manager();
+        let initial = cold.new_work_from_server(update(&replay_history.events, 9, 9), vec![]).unwrap();
+        activation("cold-init", &cold, &initial, &out);
+        let mut cold_lang = C2dLanguageDriver::new(&initial, "c2-namespace", "c2_queue",
+            result.clone(), workflow_result, None);
+        let cold_initial_commands = respond("cold-init", &mut cold, &mut cold_lang, initial);
+        assert_eq!(cold_initial_commands, warm_initial_commands);
+        let cold_execution_count = 0;
+        assert!(cold.drain_queued_local_activities().is_empty());
+        assert_eq!(cold.machines.last_processed_event, 3);
+        let cold_resume = cold.get_next_activation().unwrap();
+        activation("cold-resume", &cold, &cold_resume, &out);
+        assert_eq!(cold.machines.last_processed_event, 9);
+        assert_eq!(cold.machines.get_last_wft_started_id(), 9);
+        assert!(cold.drain_queued_local_activities().is_empty());
+        println!("C2D COLD_FOLD observed last_processed 3->9 in one get_next_activation; external_execution_count={cold_execution_count}");
+        let cold_final_commands = respond("cold-resume", &mut cold, &mut cold_lang, cold_resume.clone());
+        assert_eq!(cold_final_commands, warm_final_commands);
+        let tail = cold.get_next_activation().unwrap();
+        activation("cold-terminal", &cold, &tail, &out);
+        assert!(tail.jobs.is_empty());
+        assert!(cold.machines.have_seen_terminal_event);
+        assert_eq!(cold.machines.last_processed_event, 12);
+        let termination_requests = cold.drain_queued_local_activities();
+        assert!(matches!(termination_requests.as_slice(), [LocalActRequest::CancelAllInRun(id)] if id == RUN_ID));
+        println!("C2D COLD_LA_TERMINATION CancelAllInRun; no New LA request");
+        assert!(cold_lang.completed);
+        println!("C2D COLD_NORMAL_COMPLETION marker11 and terminal12 matched without fatal");
+        for act in [&warm_resume, &cold_resume] {
+            assert_eq!(act.jobs.len(), 1);
+            let Some(Variant::ResolveActivity(resolution)) = &act.jobs[0].variant else { panic!("expected LA resolve"); };
+            assert_eq!(resolution.seq, 1);
+            assert!(resolution.is_local);
+            assert_eq!(act.timestamp.as_ref().unwrap().seconds, (T+17) as i64);
+            assert_eq!(act.timestamp.as_ref().unwrap().nanos, 0);
+            assert_eq!(act.history_length, 9);
+        }
+        assert_eq!(warm_resume.jobs, cold_resume.jobs);
+        assert!(!warm_resume.is_replaying);
+        assert!(cold_resume.is_replaying);
+        let warm_observations = warm_lang.observations.borrow();
+        let cold_observations = cold_lang.observations.borrow();
+        println!("C2D LANGUAGE_OBSERVATIONS warm={warm_observations:?} cold={cold_observations:?}");
+        for observations in [&*warm_observations, &*cold_observations] {
+            assert_eq!(observations.len(), 2);
+            assert_eq!(observations[0].workflow_time, UNIX_EPOCH + Duration::from_secs(T));
+            assert_eq!(observations[0].history_length, 3);
+            assert_eq!(observations[1].workflow_time, UNIX_EPOCH + Duration::from_secs(T+17));
+            assert_eq!(observations[1].history_length, 9);
+        }
+        assert!(warm_observations.iter().all(|o| !o.is_replaying));
+        assert!(cold_observations.iter().all(|o| o.is_replaying));
+        save(&out.join("language-observations.txt"), format!("warm={warm_observations:#?}\ncold={cold_observations:#?}\n").as_bytes());
+        println!("C2D RESULT conditional_semantic_convergence=PASS warm_external_calls=1 cold_external_calls=0 resolve_jobs_per_path=1");
+    }
+}
